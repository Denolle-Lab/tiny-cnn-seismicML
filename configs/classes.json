    "Ice quake": {"eventtype": ["ice quake"], "min_magnitude": 1.0, "max_magnitude": 9.0},
    "Landslide": {"eventtype": ["landslide", "avalanche"], "min_magnitude": 1.0, "max_magnitude": 9.0},
